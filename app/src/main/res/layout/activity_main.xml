<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114"
    android:clipChildren="false">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/history_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101114"
        android:orientation="vertical"
        android:paddingTop="84dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="72dp"
            android:paddingEnd="72dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_title"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/history_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#BFC0C5"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:id="@+id/history_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingBottom="24dp">

            <GridLayout
                android:id="@+id/history_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="4"
                android:orientation="horizontal" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101114"
        android:orientation="vertical"
        android:paddingTop="84dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="72dp"
            android:paddingEnd="72dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/live_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/following_live_title"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/live_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#BFC0C5"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/following_live_button"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:minWidth="145dp"
                    android:nextFocusRight="@id/popular_live_button"
                    android:text="@string/following"
                    android:textColor="@color/tv_button_text" />

                <Button
                    android:id="@+id/popular_live_button"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:minWidth="145dp"
                    android:nextFocusLeft="@id/following_live_button"
                    android:text="@string/popular"
                    android:textColor="@color/tv_button_text" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/live_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingBottom="24dp">

            <GridLayout
                android:id="@+id/live_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="4"
                android:orientation="horizontal" />
        </ScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/player_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="#B0000000"
        android:padding="12dp"
        android:text="@string/player_hint"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/recommendations_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101114"
        android:orientation="vertical"
        android:paddingTop="84dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="72dp"
            android:paddingEnd="72dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recommendations_title"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recommendations_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#BFC0C5"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/refresh_recommendations_button"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="220dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/refresh_recommendations"
                android:textColor="@color/tv_button_text" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/recommendations_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingBottom="24dp">

            <GridLayout
                android:id="@+id/recommendations_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="4"
                android:orientation="horizontal" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/following_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101114"
        android:orientation="vertical"
        android:paddingTop="84dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="72dp"
            android:paddingEnd="72dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/following_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/following_accounts_title"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/following_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#BFC0C5"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/following_back_button"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="150dp"
                android:text="@string/back_to_following"
                android:textColor="@color/tv_button_text"
                android:visibility="gone" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/following_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"
            android:paddingBottom="24dp">

            <GridLayout
                android:id="@+id/following_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="4"
                android:orientation="horizontal" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="top"
        android:background="#F5101114"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="72dp"
        android:paddingTop="10dp"
        android:paddingEnd="72dp"
        android:paddingBottom="10dp"
        android:elevation="24dp">

        <TextView
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/recommendations_button"
            android:layout_width="116dp"
            android:layout_height="52dp"
            android:background="@drawable/tab_button_background"
            android:focusable="true"
            android:minWidth="0dp"
            android:nextFocusRight="@id/history_button"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/for_you"
            android:textColor="@color/tv_button_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/history_button"
            android:layout_width="104dp"
            android:layout_height="52dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/tab_button_background"
            android:focusable="true"
            android:minWidth="0dp"
            android:nextFocusLeft="@id/recommendations_button"
            android:nextFocusRight="@id/live_button"
            android:text="@string/history"
            android:textColor="@color/tv_button_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/live_button"
            android:layout_width="92dp"
            android:layout_height="52dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/tab_button_background"
            android:focusable="true"
            android:minWidth="0dp"
            android:nextFocusLeft="@id/history_button"
            android:nextFocusRight="@id/login_button"
            android:text="@string/live"
            android:textColor="@color/tv_button_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/login_button"
            android:layout_width="116dp"
            android:layout_height="52dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/tab_button_background"
            android:focusable="true"
            android:minWidth="0dp"
            android:nextFocusDown="@id/following_accounts_button"
            android:nextFocusLeft="@id/live_button"
            android:text="@string/account"
            android:textColor="@color/tv_button_text"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101114"
        android:focusable="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="72dp"
        android:paddingTop="84dp"
        android:paddingEnd="72dp"
        android:paddingBottom="36dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/qr_image"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:background="#FFFFFF"
            android:contentDescription="@string/qr_login_title"
            android:padding="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/login_details"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/login_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qr_login_title"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/login_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/qr_login_instructions"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />

            <Button
                android:id="@+id/following_accounts_button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="300dp"
                android:nextFocusUp="@id/login_button"
                android:nextFocusDown="@id/new_qr_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/view_following"
                android:textColor="@color/tv_button_text"
                android:visibility="gone" />

            <Button
                android:id="@+id/new_qr_button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="300dp"
                android:nextFocusUp="@id/following_accounts_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/new_qr_code"
                android:textColor="@color/tv_button_text" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
