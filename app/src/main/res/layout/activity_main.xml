<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/diagnostics_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingTop="48dp"
        android:paddingEnd="72dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics_title"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:lineSpacingExtra="5dp"
            android:textColor="#D8D8DC"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/focus_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FB7299"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refresh_button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="220dp"
                android:nextFocusRight="@id/live_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:textColor="@color/tv_button_text"
                android:text="@string/refresh_diagnostics" />

            <Button
                android:id="@+id/live_button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="260dp"
                android:nextFocusLeft="@id/refresh_button"
                android:nextFocusRight="@id/login_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:textColor="@color/tv_button_text"
                android:text="@string/test_live_stream" />

            <Button
                android:id="@+id/login_button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="240dp"
                android:nextFocusLeft="@id/live_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/qr_login"
                android:textColor="@color/tv_button_text" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/player_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="#B0000000"
        android:padding="12dp"
        android:text="@string/player_hint"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/login_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2101114"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="48dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/qr_image"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:background="#FFFFFF"
            android:contentDescription="@string/qr_login_title"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qr_login_title"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/login_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/qr_login_instructions"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />

            <Button
                android:id="@+id/new_qr_button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="300dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/new_qr_code"
                android:textColor="@color/tv_button_text" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
