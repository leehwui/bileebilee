<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/diagnostics_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingTop="48dp"
        android:paddingEnd="72dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics_title"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:lineSpacingExtra="5dp"
            android:textColor="#D8D8DC"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/focus_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FB7299"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refresh_button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="220dp"
                android:nextFocusRight="@id/live_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:textColor="@color/tv_button_text"
                android:text="@string/refresh_diagnostics"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/live_button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="260dp"
                android:nextFocusLeft="@id/refresh_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:textColor="@color/tv_button_text"
                android:text="@string/test_live_stream"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/player_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="#B0000000"
        android:padding="12dp"
        android:text="@string/player_hint"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

</FrameLayout>
