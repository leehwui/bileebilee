<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101114">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/diagnostics_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingTop="48dp"
        android:paddingEnd="72dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics_title"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:lineSpacingExtra="5dp"
            android:textColor="#D8D8DC"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/focus_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FB7299"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/recommendations_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="0dp"
                android:nextFocusRight="@id/history_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:textColor="@color/tv_button_text"
                android:text="@string/recommendations" />

            <Button
                android:id="@+id/history_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="0dp"
                android:nextFocusLeft="@id/recommendations_button"
                android:nextFocusRight="@id/live_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/history"
                android:textColor="@color/tv_button_text" />

            <Button
                android:id="@+id/live_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="0dp"
                android:nextFocusLeft="@id/history_button"
                android:nextFocusRight="@id/login_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:textColor="@color/tv_button_text"
                android:text="@string/live" />

            <Button
                android:id="@+id/login_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="0dp"
                android:nextFocusLeft="@id/live_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/qr_login"
                android:textColor="@color/tv_button_text" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/history_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101114"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingEnd="56dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_title"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/history_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#BFC0C5"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/more_history_button"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="220dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/more_history"
                android:textColor="@color/tv_button_text" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="22dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingBottom="36dp">

            <GridLayout
                android:id="@+id/history_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="4"
                android:orientation="horizontal" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101114"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingEnd="56dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/live_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/following_live_title"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/live_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#BFC0C5"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/following_live_button"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:minWidth="170dp"
                    android:nextFocusRight="@id/popular_live_button"
                    android:text="@string/following"
                    android:textColor="@color/tv_button_text" />

                <Button
                    android:id="@+id/popular_live_button"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:minWidth="170dp"
                    android:nextFocusLeft="@id/following_live_button"
                    android:nextFocusRight="@id/more_live_button"
                    android:text="@string/popular"
                    android:textColor="@color/tv_button_text" />

                <Button
                    android:id="@+id/more_live_button"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:minWidth="190dp"
                    android:nextFocusLeft="@id/popular_live_button"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/more_live_rooms"
                    android:textColor="@color/tv_button_text" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="22dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingBottom="36dp">

            <GridLayout
                android:id="@+id/live_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="4"
                android:orientation="horizontal" />
        </ScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/player_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="#B0000000"
        android:padding="12dp"
        android:text="@string/player_hint"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/recommendations_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101114"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingEnd="56dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recommendations_title"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recommendations_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#BFC0C5"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/refresh_recommendations_button"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="250dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/refresh_recommendations"
                android:textColor="@color/tv_button_text" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/recommendations_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="22dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingBottom="36dp">

            <GridLayout
                android:id="@+id/recommendations_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:columnCount="4"
                android:orientation="horizontal" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2101114"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="48dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/qr_image"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:background="#FFFFFF"
            android:contentDescription="@string/qr_login_title"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qr_login_title"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/login_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/qr_login_instructions"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />

            <Button
                android:id="@+id/new_qr_button"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:minWidth="300dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/new_qr_code"
                android:textColor="@color/tv_button_text" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
